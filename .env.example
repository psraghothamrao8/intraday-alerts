# Claude API (spec 01 §5). Set a monthly spend limit in the Anthropic console.
ANTHROPIC_API_KEY=

# GitHub fine-grained token: ONLY this repo, Contents read/write, 90-day expiry (spec 01 §8)
GITHUB_TOKEN=

# Dashboard encryption passphrase: long and random; you type the same one into the dashboard once per device
DATA_PASSPHRASE=

# Web Push (generated by `python -m engine vapid-gen`)
VAPID_PRIVATE_KEY_PATH=secrets/vapid_private.pem
VAPID_SUBJECT=mailto:you@example.com

# Broker API (your broker's names may differ)
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_CLIENT_ID=
BROKER_PASSWORD=          # only for login_mode: auto_totp
BROKER_TOTP_SECRET=       # only for login_mode: auto_totp

# Optional Telegram backup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
